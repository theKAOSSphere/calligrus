# Files embedded in the exe (included from CMakeLists.txt), read through
# src/resources.h: the default fonts, the demo document and the built-in themes.
#
# Each file becomes a generated .cpp holding its bytes (cmake/embed.cmake, run
# at build time, so a font is converted again only when it changes), and one
# table lists them all by name. The theme list is whatever *.toml files
# themes/ contains: adding a file there re-runs CMake (CONFIGURE_DEPENDS)
# and the new theme is built in, nothing to edit here.
set(_res_dir ${CMAKE_BINARY_DIR}/resources)
set(_res_sources "")
set(_res_decls "")
set(_res_table "")
set(_res_count 0)

# calligrus_embed(<name in the exe> <file on disk>)
function(calligrus_embed name file)
    math(EXPR _i "${_res_count}")
    set(_symbol res_${_i})
    set(_out ${_res_dir}/${_symbol}.cpp)
    add_custom_command(
        OUTPUT ${_out}
        COMMAND ${CMAKE_COMMAND} -DIN=${file} -DOUT=${_out} -DSYMBOL=${_symbol} -P ${CMAKE_SOURCE_DIR}/cmake/embed.cmake
        DEPENDS ${file} ${CMAKE_SOURCE_DIR}/cmake/embed.cmake
        COMMENT "Embedding ${name}"
        VERBATIM)
    math(EXPR _next "${_res_count} + 1")
    set(_res_count ${_next} PARENT_SCOPE)
    set(_res_sources ${_res_sources} ${_out} PARENT_SCOPE)
    set(_res_decls "${_res_decls}extern const unsigned char ${_symbol}[];\nextern const size_t ${_symbol}_size;\n" PARENT_SCOPE)
    set(_res_table "${_res_table}    {\"${name}\", ${_symbol}, ${_symbol}_size},\n" PARENT_SCOPE)
endfunction()

# --- fonts (licences: assets/fonts/*.txt) ------------------------------------------
foreach(_font IN ITEMS
        IBMPlexSans-Regular.ttf IBMPlexSans-Bold.ttf IBMPlexSans-Italic.ttf IBMPlexSans-BoldItalic.ttf
        CascadiaCode-Regular.ttf Hack-Regular.ttf Ubuntu-Light.ttf NotoEmoji-Regular.ttf emoji-icon-font.ttf NotoSansSymbols2-Regular.ttf latinmodern-math.otf)
    calligrus_embed(fonts/${_font} ${CMAKE_SOURCE_DIR}/assets/fonts/${_font})
endforeach()

# --- the demo document (this app's own) -----------------
calligrus_embed(demo.md ${CMAKE_SOURCE_DIR}/assets/demo.md)

# --- window icon (the exe icon is src/app.rc)
calligrus_embed(icon-256.png ${CMAKE_SOURCE_DIR}/assets/icon/icon-256.png)

# --- built-in themes: every themes/*.toml ------------------------------------
file(GLOB _themes CONFIGURE_DEPENDS ${CMAKE_SOURCE_DIR}/themes/*.toml)
list(SORT _themes)
foreach(_theme IN LISTS _themes)
    get_filename_component(_file ${_theme} NAME)
    calligrus_embed(themes/${_file} ${_theme})
endforeach()

# --- the table ----------------------------------------------------------------------------
set(_gen "// Generated by cmake/resources.cmake. Do not edit.\n#include <cstddef>\n\n")
string(APPEND _gen "${_res_decls}\n")
string(APPEND _gen "struct EmbeddedResource {\n    const char* name;\n    const unsigned char* data;\n    size_t size;\n};\n\n")
string(APPEND _gen "extern const EmbeddedResource kEmbeddedResources[] = {\n${_res_table}};\n")
string(APPEND _gen "extern const size_t kEmbeddedResourceCount = ${_res_count};\n")
file(CONFIGURE OUTPUT ${_res_dir}/resources_table.cpp CONTENT "${_gen}")

# A small library so the app and the test tools can all use the same files.
add_library(calligrus-resources STATIC src/resources.cpp ${_res_dir}/resources_table.cpp ${_res_sources})
if(MSVC)
    target_compile_options(calligrus-resources PRIVATE /utf-8 /MP)
endif()
