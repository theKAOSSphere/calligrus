# Syntax highlighting for fenced code blocks (included from CMakeLists.txt).
#
# Uses tree-sitter: the C runtime and the grammars vendored in
# grammars (shared with the Rust app, which compiles the very same
# files), compiled into the exe. The queries, theme.txt and languages.txt are
# embedded too, so the exe needs no extra files.
enable_language(C)

set(GRAMMARS_DIR ${CMAKE_SOURCE_DIR}/grammars)

# Language names = first word of each non-comment line of languages.txt.
file(STRINGS ${GRAMMARS_DIR}/languages.txt _lines)
set(HIGHLIGHT_LANGUAGES "")
foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
        continue()
    endif()
    string(REGEX MATCH "^[^ \t]+" _name "${_line}")
    list(APPEND HIGHLIGHT_LANGUAGES ${_name})
endforeach()

# --- the C code: tree-sitter runtime + one parser (+ scanner) per language -------
set(_c_sources ${GRAMMARS_DIR}/runtime/src/lib.c)
foreach(_name IN LISTS HIGHLIGHT_LANGUAGES)
    set(_files ${GRAMMARS_DIR}/${_name}/src/parser.c)
    if(EXISTS ${GRAMMARS_DIR}/${_name}/src/scanner.c)
        list(APPEND _files ${GRAMMARS_DIR}/${_name}/src/scanner.c)
    endif()
    # Each grammar includes its own src/tree_sitter/parser.h (some with <...>).
    set_source_files_properties(${_files} PROPERTIES INCLUDE_DIRECTORIES ${GRAMMARS_DIR}/${_name}/src)
    list(APPEND _c_sources ${_files})
endforeach()
add_library(calligrus-treesitter STATIC ${_c_sources})
set_target_properties(calligrus-treesitter PROPERTIES C_STANDARD 11 C_STANDARD_REQUIRED ON)
# Grammars find their own src/tree_sitter/parser.h next to them ("..." include).
target_include_directories(calligrus-treesitter
    PRIVATE ${GRAMMARS_DIR}/runtime/src
    PUBLIC ${GRAMMARS_DIR}/runtime/include)
if(MSVC)
    # Third-party C: no warnings. UTF-8 sources; the conforming preprocessor is
    # needed by the AutoHotkey scanner's variadic macros; /MP = parallel compile.
    target_compile_options(calligrus-treesitter PRIVATE /W0 /utf-8 /Zc:preprocessor /MP)
endif()

# --- embedded text: queries, theme.txt, languages.txt ----------------------------
# Written at configure time; editing any of these files re-runs CMake.
function(_embed_bytes var file)
    file(READ ${file} _hex HEX)
    string(LENGTH "${_hex}" _len)
    math(EXPR _len "${_len} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
    set(${var}_BYTES "${_bytes}" PARENT_SCOPE)
    set(${var}_LEN ${_len} PARENT_SCOPE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
endfunction()

set(_gen "// Generated by cmake/highlight.cmake from grammars/. Do not edit.\n")
string(APPEND _gen "#include <cstddef>\n#include \"${CMAKE_SOURCE_DIR}/src/highlight_embedded.h\"\n\n")
set(_table "")
foreach(_name IN LISTS HIGHLIGHT_LANGUAGES)
    string(APPEND _gen "extern \"C\" const TSLanguage* tree_sitter_${_name}(void);\n")
    _embed_bytes(HL ${GRAMMARS_DIR}/${_name}/highlights.scm)
    string(APPEND _gen "static const unsigned char hl_${_name}[] = {${HL_BYTES}0};\n")
    if(EXISTS ${GRAMMARS_DIR}/${_name}/injections.scm)
        _embed_bytes(INJ ${GRAMMARS_DIR}/${_name}/injections.scm)
        string(APPEND _gen "static const unsigned char inj_${_name}[] = {${INJ_BYTES}0};\n")
        set(_inj "reinterpret_cast<const char*>(inj_${_name}), ${INJ_LEN}")
    else()
        set(_inj "\"\", 0")
    endif()
    string(APPEND _table "    {\"${_name}\", tree_sitter_${_name}, reinterpret_cast<const char*>(hl_${_name}), ${HL_LEN}, ${_inj}},\n")
endforeach()
_embed_bytes(THEME ${GRAMMARS_DIR}/theme.txt)
_embed_bytes(LANGS ${GRAMMARS_DIR}/languages.txt)
list(LENGTH HIGHLIGHT_LANGUAGES _count)
string(APPEND _gen "\nconst EmbeddedGrammar kEmbeddedGrammars[] = {\n${_table}};\n")
string(APPEND _gen "const size_t kEmbeddedGrammarCount = ${_count};\n\n")
string(APPEND _gen "static const unsigned char theme_txt[] = {${THEME_BYTES}0};\n")
string(APPEND _gen "extern const char* const kEmbeddedThemeTxt = reinterpret_cast<const char*>(theme_txt);\n")
string(APPEND _gen "const size_t kEmbeddedThemeTxtLen = ${THEME_LEN};\n")
string(APPEND _gen "static const unsigned char languages_txt[] = {${LANGS_BYTES}0};\n")
string(APPEND _gen "extern const char* const kEmbeddedLanguagesTxt = reinterpret_cast<const char*>(languages_txt);\n")
string(APPEND _gen "const size_t kEmbeddedLanguagesTxtLen = ${LANGS_LEN};\n")
set(HIGHLIGHT_EMBEDDED ${CMAKE_BINARY_DIR}/highlight_embedded.cpp)
file(CONFIGURE OUTPUT ${HIGHLIGHT_EMBEDDED} CONTENT "${_gen}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${GRAMMARS_DIR}/languages.txt)

# --- the app ---------------------------------------------------------------------
target_sources(calligrus PRIVATE src/highlight.cpp ${HIGHLIGHT_EMBEDDED})
target_link_libraries(calligrus PRIVATE calligrus-treesitter)

# Highlighting tests against the golden files in grammars/tests (console, no window).
add_executable(calligrus-highlight-test src/highlight_test.cpp src/highlight.cpp src/syntax_entries.cpp ${HIGHLIGHT_EMBEDDED})
target_link_libraries(calligrus-highlight-test PRIVATE calligrus-treesitter)
target_compile_definitions(calligrus-highlight-test PRIVATE CALLIGRUS_GRAMMARS_DIR="${GRAMMARS_DIR}")
if(MSVC)
    target_compile_options(calligrus-highlight-test PRIVATE /utf-8 /W4 /permissive-)
endif()
