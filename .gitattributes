# Text files are stored and checked out with LF line endings on every OS.
* text=auto eol=lf

# Test data keeps its exact bytes: some fixtures are CRLF on purpose (e.g. edit-crlf.toml checks
# that the config editor keeps Windows line endings).
spec/tests/** -text
tests/** -text

# Binary files.
*.png binary
*.ico binary
*.ttf binary
*.otf binary
*.pdf binary
*.webp binary

# GitHub's language statistics: the tree-sitter grammars are vendored upstream code (their generated
# parser.c files would otherwise make the repository look like 97% C), and the test data is data.
grammars/** linguist-vendored
tests/** linguist-vendored
spec/tests/** linguist-vendored
